APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://traderstack:change-me@postgres:5432/traderstack
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change-me

# No secrets belong in source control. Populate locally or from a secret manager.
ANTHROPIC_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
DUNE_API_KEY=
CRYPTOPANIC_API_KEY=
LUNARCRUSH_API_KEY=
ALTFINS_API_KEY=
PERPLEXITY_API_KEY=

# Hummingbot API credentials must be supplied only at runtime.
HUMMINGBOT_API_URL=http://hummingbot-api:8000
HUMMINGBOT_API_USERNAME=
HUMMINGBOT_API_PASSWORD=
HUMMINGBOT_ACCOUNT_NAME=paper_account
HUMMINGBOT_CONNECTOR_NAME=kraken_paper_trade

# Execution remains paper-only until explicitly promoted through governance.
TRADING_MODE=paper
PAPER_STARTING_NAV_USD=10000
MVP_ASSETS=BTC,ETH,SOL
MAX_REFERENCE_DIVERGENCE_BPS=50
MAX_MARKET_DATA_AGE_SECONDS=5
MAX_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.02
MAX_ACCOUNT_DRAWDOWN_PCT=0.10
MIN_ORDER_NOTIONAL_USD=10
KILL_SWITCH=true

# Signal-driven pipeline sizing and candle ingestion.
BASE_NOTIONAL_PCT=0.02
MIN_CONSENSUS_CONFIDENCE=0.35
CANDLE_INTERVAL=1h
CANDLE_COUNT=250
CANDLE_REFRESH_SECONDS=300

# Claude meta-agent model used when --meta-agent is enabled.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Execution reconciliation cadence for --submit runs.
RECONCILE_INTERVAL_SECONDS=30

# Per-asset Dune query IDs for on-chain enrichment, e.g. BTC:1234567,ETH:2345678
DUNE_QUERY_IDS=
