APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://traderstack:change-me@postgres:5432/traderstack
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change-me

# No secrets belong in source control. Populate locally or from a secret manager.
# Blank values are treated as unset: optional intel providers are not registered.
ANTHROPIC_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
DUNE_API_KEY=
# Dune query id per asset: "BTC:123456,ETH:234567". Each query must return one
# row with exchange_netflow_z and large_wallet_accumulation columns.
DUNE_QUERY_IDS=
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_API_PLAN=developer
LUNARCRUSH_API_KEY=
ALTFINS_API_KEY=
PERPLEXITY_API_KEY=
# Crucix local intel (off unless CRUCIX_ENABLED=true or URL/key set).
# Blank URL uses http://host.docker.internal:8787 when the provider is registered.
CRUCIX_ENABLED=false
CRUCIX_BASE_URL=
CRUCIX_API_KEY=

# External intelligence in the live loop. Providers with a key set are fetched
# every cycle (cached), merged into the feature vector, and an adverse news
# event deterministically blocks new risk for that cycle.
INTELLIGENCE_CACHE_SECONDS=300
INTELLIGENCE_BLOCK_ON_ADVERSE_NEWS=true
# true = reject the cycle when no external provider returned anything.
INTELLIGENCE_REQUIRED=false

# Constrained meta-agent (Epic 6). The reviewer sits between the deterministic
# pipeline and execution: it can veto a cycle or nudge confidence within the
# bounded delta, and can never choose a side, an asset or a size.
#   off      = never called
#   advisory = called and recorded only (default); execution is unaffected
#   veto     = a veto or ANY failure suppresses the paper order for that cycle
# Veto mode requires ANTHROPIC_API_KEY and fails at startup without it.
META_AGENT_MODE=advisory
META_AGENT_MODEL=claude-haiku-4-5
META_AGENT_MAX_TOKENS=512
META_AGENT_TIMEOUT_SECONDS=20
# Daily budgets; 0 disables the limit. Exceeding one makes the reviewer
# unavailable, which fails closed in veto mode.
META_AGENT_MAX_CALLS_PER_DAY=2000
META_AGENT_MAX_TOKENS_PER_DAY=2000000
# Identical evidence inside this window reuses the previous decision.
META_AGENT_CACHE_SECONDS=60
# USD per million tokens, for cost telemetry only. Verify against current
# Anthropic pricing; these are not authoritative.
META_AGENT_INPUT_COST_PER_MTOK=1.0
META_AGENT_OUTPUT_COST_PER_MTOK=5.0

# Hummingbot API credentials must be supplied only at runtime.
HUMMINGBOT_API_URL=http://hummingbot-api:8000
HUMMINGBOT_API_USERNAME=
HUMMINGBOT_API_PASSWORD=
HUMMINGBOT_ACCOUNT_NAME=paper_account
HUMMINGBOT_CONNECTOR_NAME=kraken_paper_trade
# Only used by the optional `hummingbot-api`/`hummingbot-postgres` services in
# docker-compose.yml (profile "execution"). CONFIG_PASSWORD encrypts Hummingbot's
# own bot credential files at rest; DB_PASSWORD is for its dedicated Postgres
# database, separate from this app's own DATABASE_URL above.
HUMMINGBOT_CONFIG_PASSWORD=
HUMMINGBOT_DB_PASSWORD=

# paper  = decisions + optional Hummingbot paper submit (--submit)
# shadow = same pipeline; records would-have-been orders; never submits
# live   = rejected at startup. Live capital is out of scope.
TRADING_MODE=paper
# Primary tick stream: kraken (WS v2), kraken_rest (paper-only public Spot
# /0/public/Ticker poll — use when WS hangs), or robinhood_chain (Uniswap
# swap feed; requires ROBINHOOD_CHAIN_WS_URL / ROBINHOOD_CHAIN_POOLS below).
# kraken_rest is rejected unless TRADING_MODE=paper.
VENUE_FEED=kraken
PAPER_STARTING_NAV_USD=10000
MVP_ASSETS=BTC,ETH,SOL
MAX_REFERENCE_DIVERGENCE_BPS=50
MAX_MARKET_DATA_AGE_SECONDS=5
# Market-data quality gate on the raw venue tick (rejection: spread_limit_exceeded),
# evaluated before any proposal exists. Distinct from RISK_MAX_SPREAD_BPS below,
# which is the risk engine's own (Zone C, policy-versioned) spread check — see
# docs/EXECUTION-ARCHITECTURE.md, "Two spread limits, deliberately".
MAX_SPREAD_BPS=30
MAX_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.02
MAX_ACCOUNT_DRAWDOWN_PCT=0.10
KILL_SWITCH=true

# --- risk plane (Epic 7) ---
# Deterministic risk policy. These are the only place limits may change: no
# agent, LLM message or runtime API can alter them. Any change here changes
# RiskEngine.policy_version, which is stamped into every risk audit record.
RISK_POLICY_LABEL=mvp-v1
# Portfolio-level exposure controls.
MAX_OPEN_POSITIONS=5
MIN_CASH_RESERVE_PCT=0.05
MAX_GROSS_EXPOSURE_PCT=0.60
# Stale-state shutdown: no new risk against a portfolio view older than this.
MAX_PORTFOLIO_STATE_AGE_SECONDS=60
# Liquidity gate inside the risk engine.
RISK_MAX_SPREAD_BPS=30
# Volatility targeting: approved notional is scaled by
# TARGET_VOLATILITY / observed realized volatility, and never scaled up.
VOLATILITY_SIZING_ENABLED=true
TARGET_VOLATILITY=0.02
# Strategy circuit breaker.
STRATEGY_MAX_CONSECUTIVE_LOSSES=3
STRATEGY_DRAWDOWN_WINDOW=10
STRATEGY_MAX_ROLLING_DRAWDOWN_PCT=0.05
STRATEGY_BREAKER_COOLDOWN_SECONDS=3600
# Operator kill switch outside the LLM runtime. Engage with `traderstack-kill`
# (writes the sentinel file), by setting the Redis key, or with SIGUSR1.
KILL_SWITCH_FILE=var/state/KILL
KILL_SWITCH_REDIS_KEY=traderstack:kill_switch
KILL_SWITCH_REDIS_ENABLED=false
# Append-only, hash-chained risk-decision audit trail.
RISK_AUDIT_PATH=var/audit/risk_decisions.jsonl

# Provider health, quota and caching wrapper (traderstack.market.registry).
# Applies to reference-price providers, Kraken candle history and every
# intelligence fetcher; see docs/PROVIDER-CAPABILITY-MATRIX.md.
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_BREAKER_COOLDOWN_SECONDS=30
# Cached reference price age the pipeline's freshness check still evaluates
# honestly - keep this well under MAX_MARKET_DATA_AGE_SECONDS.
# Live/shadow always use this short TTL and never reuse a last-good mid.
REFERENCE_PRICE_CACHE_SECONDS=20
# Paper-only reference resilience (ignored unless TRADING_MODE=paper).
# A longer cache plus last-good reuse so a CoinGecko HTTP 429 does not
# fail-close every cycle. Last-good keeps the original observed_at; a
# moved market still trips REFERENCE_PRICE_DIVERGENCE. Set
# PAPER_REFERENCE_LAST_GOOD_SECONDS=0 to restore fail-closed on paper.
PAPER_REFERENCE_CACHE_SECONDS=120
PAPER_REFERENCE_LAST_GOOD_SECONDS=300
COINGECKO_CALLS_PER_MINUTE=25
COINGECKO_CALLS_PER_DAY=
COINMARKETCAP_CALLS_PER_MINUTE=10
COINMARKETCAP_CALLS_PER_DAY=300
CANDLE_PROVIDER_CALLS_PER_MINUTE=
INTELLIGENCE_PROVIDER_CALLS_PER_MINUTE=

# Kraken WS v2 resilience: reconnect with backoff+jitter, and reconnect a
# connection that has gone quiet for KRAKEN_STALE_AFTER_SECONDS.
KRAKEN_MAX_RECONNECT_ATTEMPTS=10
KRAKEN_BACKOFF_BASE_SECONDS=1
KRAKEN_BACKOFF_MAX_SECONDS=30
KRAKEN_STALE_AFTER_SECONDS=30
# Order-book snapshots (book channel, depth 10 by default). Kraken-venue only;
# informational today (RuntimeResult.book_snapshot), not yet wired into risk.
KRAKEN_BOOK_ENABLED=false
KRAKEN_BOOK_DEPTH=10
# Poll interval for VENUE_FEED=kraken_rest. Keep under MAX_MARKET_DATA_AGE_SECONDS.
KRAKEN_REST_POLL_SECONDS=1

# Paper-research edge data plane (opt-in). These are NOT execution venues and
# do not add Binance/Bybit order routing. Features land on AssetFeatureVector.edge
# as research/risk context only — RiskEngine does not read them to size or
# authorize a trade. Streaming reconnect matches Kraken (market.streaming).
BINANCE_LIQ_ENABLED=false
BINANCE_LIQ_URL=wss://fstream.binance.com/ws/!forceOrder@arr
BINANCE_LIQ_WINDOW_SECONDS=60
BINANCE_LIQ_BASELINE_SECONDS=900
BINANCE_LIQ_COUNT_CAP=20
# 0 = no application-level stale timeout (liquidations are sparse; WS pings
# remain the liveness signal).
BINANCE_LIQ_STALE_AFTER_SECONDS=0
BINANCE_LIQ_MAX_AGE_SECONDS=0
BOOK_TICKER_ENABLED=false
# binance (USDT-M combined bookTicker) or bybit (v5 linear tickers).
BOOK_TICKER_VENUE=binance
# Empty = venue default. Not an order-routing endpoint.
BOOK_TICKER_URL=
BOOK_TICKER_QUOTE=USDT
BOOK_TICKER_MAX_AGE_SECONDS=5
BOOK_TICKER_STALE_AFTER_SECONDS=30
EDGE_MAX_RECONNECT_ATTEMPTS=10
EDGE_BACKOFF_BASE_SECONDS=1
EDGE_BACKOFF_MAX_SECONDS=30

# Pre-trade self-check: backtest + walk-forward the strategy over recent candles
# before any proposal reaches the risk engine. Missing/stale history rejects.
PRETRADE_BACKTEST_ENABLED=true
PRETRADE_CANDLE_INTERVAL=1h
PRETRADE_CANDLE_COUNT=400
PRETRADE_MIN_CANDLES=250
PRETRADE_MAX_CANDLE_AGE_SECONDS=7200
PRETRADE_MIN_EXCESS_RETURN=0.0
PRETRADE_MAX_DRAWDOWN_PCT=0.15
PRETRADE_MIN_SHARPE=0.0
PRETRADE_MIN_TRADES=3
PRETRADE_REQUIRE_WALKFORWARD=true
PRETRADE_FEE_BPS=10
PRETRADE_SLIPPAGE_BPS=5
# Charged on a paper fill when the venue reports no fee (typical of paper
# connectors). Debited from cash and realized PnL so NAV, daily loss and
# drawdown breakers are not systematically optimistic. Default matches
# PRETRADE_FEE_BPS. Set to 0 only if the venue always reports fees.
PAPER_FEE_BPS=10
# Paper research mode (documented paper default). When TRADING_MODE=paper,
# the pre-trade ensemble includes a candle-only baseline voter so a dry-run
# on Kraken Spot OHLC can reach an intentional risk decision even when
# optional intel (Dune/LunarCrush/CryptoPanic/Perplexity/altFINS), Crucix,
# and other edge fields are unset. Set false to keep the strict two-voter
# candle ensemble. Ignored unless TRADING_MODE=paper — never loosens
# live/shadow, never bypasses RiskEngine / the kill switch, never raises
# notionals. See docs/RUNBOOK.md, "Paper research mode and strategy consensus".
PAPER_RESEARCH_MODE=true
# Paper-only pre-trade performance floors (ignored unless TRADING_MODE=paper).
# Require non-catastrophic evidence (total return at/above the floor, at
# least one completed trade) and keep the gate enabled. A 16-day Spot MA
# lookback can lose a few percent on a pullback; 0.0 blocked every BTC/SOL
# cycle on the WSL retest. Live/shadow keep PRETRADE_MIN_EXCESS_RETURN /
# PRETRADE_MIN_SHARPE / PRETRADE_MIN_TRADES. See docs/RUNBOOK.md,
# "Paper pre-trade thresholds on Spot OHLC".
PAPER_PRETRADE_MIN_TOTAL_RETURN=-0.15
PAPER_PRETRADE_MIN_EXCESS_RETURN=-0.10
PAPER_PRETRADE_MIN_SHARPE=-10.0
PAPER_PRETRADE_MIN_TRADES=1
PAPER_PRETRADE_MIN_WALKFORWARD_EXCESS_RETURN=-0.10

# --- execution hardening (Epic 8) ---
# Venue state is authoritative. A failed reconciliation pass or NAV drift past
# MAX_NAV_DRIFT_BPS blocks new submissions (data and decisions keep running)
# until a later pass is clean.
RECONCILE_INTERVAL_SECONDS=60
MAX_NAV_DRIFT_BPS=25
# Execution planner: venue lot increment, dust floor and the maximum tolerated
# deviation between the execution price and the pipeline's validated tick.
EXECUTION_MIN_NOTIONAL_USD=10
EXECUTION_LOT_STEP=0.00000001
EXECUTION_MAX_SLIPPAGE_BPS=50
# A submission timeout never means the order failed: the decision is parked as
# SUBMISSION_UNCERTAIN and only retried once reconciliation confirms the venue
# does not know the client order id.
EXECUTION_SUBMIT_TIMEOUT_SECONDS=10
EXECUTION_MAX_RETRIES=2

# Robinhood Chain (EVM-compatible) on-chain execution.
# Copy chain id, RPC URL and explorer from Robinhood's own docs
# (https://docs.robinhood.com/chain/connecting) — never guess. A wrong chain
# id/RPC can sign against the wrong network. Leave unset to keep on-chain
# execution disabled (fails closed). See docs/DATA-SOURCES.md for the
# researched values (Sept 2026): mainnet chain id 4663, testnet 46630; the
# public RPC https://rpc.mainnet.chain.robinhood.com is rate-limited with no
# websocket or archive — use a provider endpoint (Alchemy/Chainstack/dRPC).
ROBINHOOD_CHAIN_RPC_URL=
ROBINHOOD_CHAIN_ID=
# Official explorer is Blockscout: https://robinhoodchain.blockscout.com
ROBINHOOD_CHAIN_EXPLORER_URL=
ROBINHOOD_CHAIN_NATIVE_CURRENCY=ETH
ROBINHOOD_CHAIN_CONNECTOR_NAME=robinhood_chain
# Deterministic allowlists — nothing outside these can be swapped/routed through.
# Format: "SYMBOL:0xcontract:decimals,SYMBOL:0xcontract:decimals"
# Canonical tokens per Robinhood docs: WETH 0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73,
# USDG 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168 (re-verify before use).
ROBINHOOD_CHAIN_ALLOWED_TOKENS=
# Format: "0xrouter,0xrouter". Start with Uniswap only, verified against
# https://developers.uniswap.org/docs/protocols/v3/deployments/v3-robinhood-chain-deployments:
# UniversalRouter 0x8876789976decbfcbbbe364623c63652db8c0904,
# SwapRouter02   0xcaf681a66d020601342297493863e78c959e5cb2
ROBINHOOD_CHAIN_ALLOWED_ROUTERS=
# Real-time swap feed (read-only). Needs a websocket JSON-RPC endpoint — the
# public Robinhood RPC has none; use e.g. wss://robinhood-mainnet.g.alchemy.com/v2/KEY.
ROBINHOOD_CHAIN_WS_URL=
# Watched pools: "SYMBOL:v3|v4:0xpool_or_poolid:dec0:dec1:token0|token1:fee_bps,..."
# SYMBOL is BASE/QUOTE (e.g. ETH/USDG); base=token0|token1 says which side of the
# pool is BASE. Example v3 ETH/USDG 0.05% pool with WETH as token0:
#   ETH/USDG:v3:0xPOOL:18:6:token0:5
ROBINHOOD_CHAIN_POOLS=
# Uniswap v4 PoolManager (only for v4 pool ids). Documented at
# https://developers.uniswap.org/docs/protocols/v4/deployments:
#   0x8366a39cc670b4001a1121b8f6a443a643e40951  (re-verify before use)
ROBINHOOD_CHAIN_V4_POOL_MANAGER=
ROBINHOOD_CHAIN_MAX_NOTIONAL_USD=0
ROBINHOOD_CHAIN_MAX_GAS_LIMIT=500000
ROBINHOOD_CHAIN_MAX_GAS_PRICE_GWEI=5

# --- Observability (Epic 9) ---
# Optional OpenTelemetry traces. traderstack.tracing is a no-op unless both
# the `opentelemetry` extra is installed AND this endpoint is set (an OTLP
# collector, e.g. http://otel-collector:4318/v1/traces). Leave unset in paper
# trading -- metrics (Prometheus) and logs (structlog/Loki) are always on.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- polymarket weather research (paper-only, opt-in) ---
# Dedicated CLI: traderstack-polymarket-weather-paper. The crypto paper loop
# never reads these. Default off. No private key / CLOB signing settings exist
# and must not be added — this module only GETs public Gamma/CLOB/NWP APIs and
# writes would-trade intents to a JSONL paper ledger.
POLYMARKET_WEATHER_ENABLED=false
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
# MIN_EDGE (namespaced): |model probability − CLOB mid| after fee haircut.
POLYMARKET_WEATHER_MIN_EDGE=0.08
# Allowlist of catalog slugs. Defaults are warm/stable climates.
POLYMARKET_WEATHER_CITIES=honolulu,san_diego,miami,phoenix,singapore,lisbon
POLYMARKET_WEATHER_FORECAST_PROVIDER=open_meteo
POLYMARKET_WEATHER_OPEN_METEO_BASE_URL=https://api.open-meteo.com
POLYMARKET_WEATHER_NOAA_BASE_URL=https://api.weather.gov
POLYMARKET_WEATHER_NOAA_USER_AGENT=DeFi-TraderStack-Agent/0.1 (paper research; no live orders)
# Assumed 1-day high-temp error (°F). A research prior, not a calibrated skill.
POLYMARKET_WEATHER_SIGMA_F=2.5
POLYMARKET_WEATHER_PAPER_NOTIONAL_USD=10
POLYMARKET_WEATHER_LEDGER_PATH=var/audit/polymarket_weather_paper.jsonl
POLYMARKET_WEATHER_TAG_SLUG=weather
POLYMARKET_WEATHER_MAX_MARKETS=40
POLYMARKET_WEATHER_CACHE_SECONDS=60
POLYMARKET_WEATHER_CALLS_PER_MINUTE=20
POLYMARKET_WEATHER_MIN_MID=0.02
POLYMARKET_WEATHER_MAX_MID=0.98
POLYMARKET_WEATHER_FEE_HAIRCUT=0.02
