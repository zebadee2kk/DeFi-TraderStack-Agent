APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://traderstack:change-me@postgres:5432/traderstack
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change-me

# No secrets belong in source control. Populate locally or from a secret manager.
ANTHROPIC_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
DUNE_API_KEY=
# Dune query id per asset: "BTC:123456,ETH:234567". Each query must return one
# row with exchange_netflow_z and large_wallet_accumulation columns.
DUNE_QUERY_IDS=
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_API_PLAN=developer
LUNARCRUSH_API_KEY=
ALTFINS_API_KEY=
PERPLEXITY_API_KEY=

# External intelligence in the live loop. Providers with a key set are fetched
# every cycle (cached), merged into the feature vector, and an adverse news
# event deterministically blocks new risk for that cycle.
INTELLIGENCE_CACHE_SECONDS=300
INTELLIGENCE_BLOCK_ON_ADVERSE_NEWS=true
# true = reject the cycle when no external provider returned anything.
INTELLIGENCE_REQUIRED=false

# Hummingbot API credentials must be supplied only at runtime.
HUMMINGBOT_API_URL=http://hummingbot-api:8000
HUMMINGBOT_API_USERNAME=
HUMMINGBOT_API_PASSWORD=
HUMMINGBOT_ACCOUNT_NAME=paper_account
HUMMINGBOT_CONNECTOR_NAME=kraken_paper_trade

# Execution remains paper-only until explicitly promoted through governance.
TRADING_MODE=paper
# Primary tick stream: kraken (WS v2) or robinhood_chain (Uniswap swap feed;
# requires the ROBINHOOD_CHAIN_WS_URL / ROBINHOOD_CHAIN_POOLS settings below).
VENUE_FEED=kraken
PAPER_STARTING_NAV_USD=10000
MVP_ASSETS=BTC,ETH,SOL
MAX_REFERENCE_DIVERGENCE_BPS=50
MAX_MARKET_DATA_AGE_SECONDS=5
MAX_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.02
MAX_ACCOUNT_DRAWDOWN_PCT=0.10
KILL_SWITCH=true

# Provider health, quota and caching wrapper (traderstack.market.registry).
# Applies to reference-price providers, Kraken candle history and every
# intelligence fetcher; see docs/PROVIDER-CAPABILITY-MATRIX.md.
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_BREAKER_COOLDOWN_SECONDS=30
# Cached reference price age the pipeline's freshness check still evaluates
# honestly - keep this well under MAX_MARKET_DATA_AGE_SECONDS.
REFERENCE_PRICE_CACHE_SECONDS=20
COINGECKO_CALLS_PER_MINUTE=25
COINGECKO_CALLS_PER_DAY=
COINMARKETCAP_CALLS_PER_MINUTE=10
COINMARKETCAP_CALLS_PER_DAY=300
CANDLE_PROVIDER_CALLS_PER_MINUTE=
INTELLIGENCE_PROVIDER_CALLS_PER_MINUTE=

# Kraken WS v2 resilience: reconnect with backoff+jitter, and reconnect a
# connection that has gone quiet for KRAKEN_STALE_AFTER_SECONDS.
KRAKEN_MAX_RECONNECT_ATTEMPTS=10
KRAKEN_BACKOFF_BASE_SECONDS=1
KRAKEN_BACKOFF_MAX_SECONDS=30
KRAKEN_STALE_AFTER_SECONDS=30
# Order-book snapshots (book channel, depth 10 by default). Kraken-venue only;
# informational today (RuntimeResult.book_snapshot), not yet wired into risk.
KRAKEN_BOOK_ENABLED=false
KRAKEN_BOOK_DEPTH=10

# Pre-trade self-check: backtest + walk-forward the strategy over recent candles
# before any proposal reaches the risk engine. Missing/stale history rejects.
PRETRADE_BACKTEST_ENABLED=true
PRETRADE_CANDLE_INTERVAL=1h
PRETRADE_CANDLE_COUNT=400
PRETRADE_MIN_CANDLES=250
PRETRADE_MAX_CANDLE_AGE_SECONDS=7200
PRETRADE_MIN_EXCESS_RETURN=0.0
PRETRADE_MAX_DRAWDOWN_PCT=0.15
PRETRADE_MIN_SHARPE=0.0
PRETRADE_MIN_TRADES=3
PRETRADE_REQUIRE_WALKFORWARD=true
PRETRADE_FEE_BPS=10
PRETRADE_SLIPPAGE_BPS=5

# Robinhood Chain (EVM-compatible) on-chain execution.
# Copy chain id, RPC URL and explorer from Robinhood's own docs
# (https://docs.robinhood.com/chain/connecting) — never guess. A wrong chain
# id/RPC can sign against the wrong network. Leave unset to keep on-chain
# execution disabled (fails closed). See docs/DATA-SOURCES.md for the
# researched values (Sept 2026): mainnet chain id 4663, testnet 46630; the
# public RPC https://rpc.mainnet.chain.robinhood.com is rate-limited with no
# websocket or archive — use a provider endpoint (Alchemy/Chainstack/dRPC).
ROBINHOOD_CHAIN_RPC_URL=
ROBINHOOD_CHAIN_ID=
# Official explorer is Blockscout: https://robinhoodchain.blockscout.com
ROBINHOOD_CHAIN_EXPLORER_URL=
ROBINHOOD_CHAIN_NATIVE_CURRENCY=ETH
ROBINHOOD_CHAIN_CONNECTOR_NAME=robinhood_chain
# Deterministic allowlists — nothing outside these can be swapped/routed through.
# Format: "SYMBOL:0xcontract:decimals,SYMBOL:0xcontract:decimals"
# Canonical tokens per Robinhood docs: WETH 0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73,
# USDG 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168 (re-verify before use).
ROBINHOOD_CHAIN_ALLOWED_TOKENS=
# Format: "0xrouter,0xrouter". Start with Uniswap only, verified against
# https://developers.uniswap.org/docs/protocols/v3/deployments/v3-robinhood-chain-deployments:
# UniversalRouter 0x8876789976decbfcbbbe364623c63652db8c0904,
# SwapRouter02   0xcaf681a66d020601342297493863e78c959e5cb2
ROBINHOOD_CHAIN_ALLOWED_ROUTERS=
# Real-time swap feed (read-only). Needs a websocket JSON-RPC endpoint — the
# public Robinhood RPC has none; use e.g. wss://robinhood-mainnet.g.alchemy.com/v2/KEY.
ROBINHOOD_CHAIN_WS_URL=
# Watched pools: "SYMBOL:v3|v4:0xpool_or_poolid:dec0:dec1:token0|token1:fee_bps,..."
# SYMBOL is BASE/QUOTE (e.g. ETH/USDG); base=token0|token1 says which side of the
# pool is BASE. Example v3 ETH/USDG 0.05% pool with WETH as token0:
#   ETH/USDG:v3:0xPOOL:18:6:token0:5
ROBINHOOD_CHAIN_POOLS=
# Uniswap v4 PoolManager (only for v4 pool ids). Documented at
# https://developers.uniswap.org/docs/protocols/v4/deployments:
#   0x8366a39cc670b4001a1121b8f6a443a643e40951  (re-verify before use)
ROBINHOOD_CHAIN_V4_POOL_MANAGER=
ROBINHOOD_CHAIN_MAX_NOTIONAL_USD=0
ROBINHOOD_CHAIN_MAX_GAS_LIMIT=500000
ROBINHOOD_CHAIN_MAX_GAS_PRICE_GWEI=5
