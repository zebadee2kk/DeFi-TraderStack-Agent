APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://traderstack:change-me@postgres:5432/traderstack
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change-me

# No secrets belong in source control. Populate locally or from a secret manager.
ANTHROPIC_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
DUNE_API_KEY=
CRYPTOPANIC_API_KEY=
LUNARCRUSH_API_KEY=
ALTFINS_API_KEY=
PERPLEXITY_API_KEY=

# Hummingbot API credentials must be supplied only at runtime.
HUMMINGBOT_API_URL=http://hummingbot-api:8000
HUMMINGBOT_API_USERNAME=
HUMMINGBOT_API_PASSWORD=
HUMMINGBOT_ACCOUNT_NAME=paper_account
HUMMINGBOT_CONNECTOR_NAME=kraken_paper_trade

# Execution remains paper-only until explicitly promoted through governance.
TRADING_MODE=paper
PAPER_STARTING_NAV_USD=10000
MVP_ASSETS=BTC,ETH,SOL
MAX_REFERENCE_DIVERGENCE_BPS=50
MAX_MARKET_DATA_AGE_SECONDS=5
MAX_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.02
MAX_ACCOUNT_DRAWDOWN_PCT=0.10
KILL_SWITCH=true

# Pre-trade self-check: backtest + walk-forward the strategy over recent candles
# before any proposal reaches the risk engine. Missing/stale history rejects.
PRETRADE_BACKTEST_ENABLED=true
PRETRADE_CANDLE_INTERVAL=1h
PRETRADE_CANDLE_COUNT=400
PRETRADE_MIN_CANDLES=250
PRETRADE_MAX_CANDLE_AGE_SECONDS=7200
PRETRADE_MIN_EXCESS_RETURN=0.0
PRETRADE_MAX_DRAWDOWN_PCT=0.15
PRETRADE_MIN_SHARPE=0.0
PRETRADE_MIN_TRADES=3
PRETRADE_REQUIRE_WALKFORWARD=true
PRETRADE_FEE_BPS=10
PRETRADE_SLIPPAGE_BPS=5

# Robinhood Chain (EVM-compatible) on-chain execution.
# Do NOT guess these — copy chain id, RPC URL and explorer from Robinhood's own
# official chain documentation. A wrong chain id/RPC can sign against the wrong
# network. Leave unset to keep on-chain execution disabled (fails closed).
ROBINHOOD_CHAIN_RPC_URL=
ROBINHOOD_CHAIN_ID=
ROBINHOOD_CHAIN_EXPLORER_URL=
ROBINHOOD_CHAIN_NATIVE_CURRENCY=ETH
ROBINHOOD_CHAIN_CONNECTOR_NAME=robinhood_chain
# Deterministic allowlists — nothing outside these can be swapped/routed through.
# Format: "SYMBOL:0xcontract:decimals,SYMBOL:0xcontract:decimals"
ROBINHOOD_CHAIN_ALLOWED_TOKENS=
# Format: "0xrouter,0xrouter"
ROBINHOOD_CHAIN_ALLOWED_ROUTERS=
ROBINHOOD_CHAIN_MAX_NOTIONAL_USD=0
ROBINHOOD_CHAIN_MAX_GAS_LIMIT=500000
ROBINHOOD_CHAIN_MAX_GAS_PRICE_GWEI=5
