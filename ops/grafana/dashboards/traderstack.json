{
  "id": null,
  "uid": "traderstack-overview",
  "title": "TraderStack Overview",
  "description": "Pipeline outcomes, risk decisions, provider health/cost, portfolio and runtime health for the DeFi TraderStack paper-trading service.",
  "tags": ["traderstack"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cycle rate & outcomes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(traderstack_pipeline_outcomes_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rejection reasons",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(traderstack_pipeline_rejections_total[5m])) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Risk decisions",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(traderstack_risk_decisions_total[5m])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Paper orders submitted",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(traderstack_paper_orders_submitted_total[5m])) by (symbol, side)",
          "legendFormat": "{{symbol}} {{side}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Provider fetch latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traderstack_provider_fetch_latency_seconds_bucket[5m])) by (le, provider, kind))",
          "legendFormat": "{{provider}}/{{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Provider fetch failures",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(traderstack_provider_fetch_failures_total[5m])) by (provider, kind)",
          "legendFormat": "{{provider}}/{{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Provider API-cost proxy (calls/sec by provider)",
      "description": "No per-provider $ pricing is configured, so this uses call volume from the same provider-fetch counters as a cost proxy: rate of external requests per provider/kind.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(traderstack_provider_fetch_latency_seconds_count[5m])) by (provider, kind)",
          "legendFormat": "{{provider}}/{{kind}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Portfolio NAV / cash (USD)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        { "expr": "traderstack_portfolio_nav_usd", "legendFormat": "NAV" },
        { "expr": "traderstack_portfolio_cash_usd", "legendFormat": "Cash" }
      ]
    },
    {
      "id": 9,
      "title": "Portfolio drawdown",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        { "expr": "traderstack_portfolio_drawdown_pct", "legendFormat": "drawdown" }
      ]
    },
    {
      "id": 10,
      "title": "Runtime healthy",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 40 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "UNHEALTHY", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "HEALTHY", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "traderstack_runtime_healthy" }]
    },
    {
      "id": 11,
      "title": "Time since last successful cycle",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 40 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - max(traderstack_last_success_unixtime) by (symbol)",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Event sink failures",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(traderstack_event_sink_failures_total[5m])) by (sink)",
          "legendFormat": "{{sink}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Candle history size",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 46 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "traderstack_candle_history_size",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Application logs (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 52 },
      "targets": [{ "expr": "{job=\"traderstack\"}" }]
    }
  ]
}
